function highpass.sample()
instance(freq,Q,w0,q_,a1,a2,a_1,a_2,phi0,phi1,phi2,aa0,aa1,aa2,b0,b1,b2,b_0,b_1,b_2,rx_n2,rx_n1,rx_n,ru_n2,ru_n1,ru_n,lx_n2,lx_n1,lx_n,lu_n2,lu_n1,lu_n)(

