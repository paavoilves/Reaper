function vca.dbx202.init()
instance(
    Vt,
    m1, m2, m3, m4,
    Re,
    lx_n, rx_n,
    lemit, remit,
    la, lb, lden,
    ra, rb, rden,
    lI1, lI2, lI3, lI4,
    rI1, rI2, rI3, rI4,
    lgain, rgain
)(
    Vt = 0.02585;
    m1 = 1.0;
    m2 = 1.003;
    m3 = 0.997;
    m4 = 1.002;
    Re = 0.00001; // Saturation strength (-90dB 2nd harmonic for G+, -70dB for E)
    lx_n = 0;
    rx_n = 0;
);

function vca.dbx202.sample()
instance(
    Vt, m1, m2, m3, m4, Re,
    lx_n, rx_n,
    lemit, remit,
    la, lb, lden,
    ra, rb, rden,
    lI1, lI2, lI3, lI4,
    rI1, rI2, rI3, rI4,
    lgain, rgain,
    ly, ry, Ec
)(
    // Static control voltage (unity gain bias)
    Ec = 0.0;

    //---- Left Channel
    lx_n = spl0;

    la = exp((Ec/(2*Vt)) / Vt);
    lb = exp((-Ec/(2*Vt)) / Vt);
    lemit = lx_n * Re;
    la = la * exp(-lemit/Vt);
    lb = lb * exp(lemit/Vt);

    lden = la + lb;
    lI1 = m1*la/lden;
    lI2 = m2*lb/lden;
    lI3 = m3*lb/lden;
    lI4 = m4*la/lden;
    lgain = (lI1 + lI4);
    ly = lx_n * lgain;

    //---- Right Channel
    rx_n = spl1;

    ra = exp((Ec/(2*Vt)) / Vt);
    rb = exp((-Ec/(2*Vt)) / Vt);
    remit = rx_n * Re;
    ra = ra * exp(-remit/Vt);
    rb = rb * exp(remit/Vt);

    rden = ra + rb;
    rI1 = m1*ra/rden;
    rI2 = m2*rb/rden;
    rI3 = m3*rb/rden;
    rI4 = m4*ra/rden;
    rgain = (rI1 + rI4);
    ry = rx_n * rgain;

    spl0 = ly;
    spl1 = ry;
);


