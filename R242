// a1, a2, b0, b1, b2 (biquad filter coefficients)
// special case gain = 1 (flat response)

    freq = freqk * 1000;
    gain_linear = 10^(gain/20);
    smoothing = 0.0005;

    fc = freq / srate * 2;

    (abs(1 - gain_linear) < 0.000001) ?
        g = 1.00001 : g = gain_linear;

    // abbreviations
    pihalf = 1.5708;
    invg = 1.0/g;

    // matching gain at Nyquist
    fc4 = fc^4;
    hny = (fc4 + g)/(fc4 + invg);

    // matching gain at f_1
    f1 = fc/sqrt(0.160 + 1.543*fc*fc);
    f14 = f1^4;
    h1 = (fc4 + f14*g)/(fc4 + f14*invg);
    phi1 = sin(pihalf*f1)^2;

    // matching gain at f_2
    f2 = fc/sqrt(0.947 + 3.806*fc*fc);
    f24 = f2^4;
    h2 = (fc4 + f24*g)/(fc4 + f24*invg);
    phi2 = sin(pihalf*f2)^2;

    // linear equations coefficients
    d1 = (h1 - 1.0)*(1.0 - phi1);
    c11 = -phi1*d1;
    c12 = phi1*phi1*(hny - h1);
