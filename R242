);

function highshelf.onepole.slider(gain,freqk)
instance(freq,fc,G,fm,phim,alpha,beta,smoothing,a1,b,b0,b1)(
    
    freq = freqk * 500 - 200;// - 1000;
    fc = freq / (srate/2);
    G = 10^(gain/20);
    
    fm = 0.9;
    phim = 1 - cos($pi * fm);
    
    alpha = (2/sqr($pi)) * (1/(sqr(fm) * G * sqr(fc))) - (1/phim);
    beta  = (2/sqr($pi)) * (G/(sqr(fm) * sqr(fc)))     - (1/phim);
    
    a1 = -alpha / (1 + alpha + sqrt(1 + 2*alpha));
    b  = -beta  / (1 + beta  + sqrt(1 + 2*beta));
    
    b0 = (1 + a1) / (1 + b);
    b1 = b * b0;
);


function highshelf.onepole.sample()
instance(freq,fc,G,fm,phim,alpha,beta,smoothing,a1,b,b0,b1,a_1,b_0,b_1,lx_n,lx_n1,lu_n,lu_n1,rx_n,rx_n1,ru_n,ru_n1)(
    
    G != 1 ? (
    
        //---- added smoothing to prevent filters getting stuck
        smoothing = 0.5;
        a_1 += smoothing * (a1 - a_1);
        b_0 += smoothing * (b0 - b_0);
        b_1 += smoothing * (b1 - b_1);
        
        //---- left
        lx_n1 = lx_n;
        lx_n = spl0;
        
        lu_n1 = lu_n;
        lu_n = b_0*lx_n + b_1*lx_n1 - a_1*lu_n1;
        
        //---- right
        rx_n1 = rx_n;
        rx_n = spl1;
        
        ru_n1 = ru_n;
        ru_n = b_0*rx_n + b_1*rx_n1 - a_1*ru_n1;
        
        switch1 ? (
            spl0 = lu_n;
            spl1 = ru_n;
            ):(
            spl0 = capacitor(lu_n);
            spl1 = capacitor(ru_n);
            spl0 = this.opamp.NE5534.sample(spl0);
            spl1 = this.opamp.NE5534.sample(spl1);
        );
        
        ):(
        
        switch1 ? (
            spl0 = spl0;
            spl1 = spl1;
            ):(
            spl0 = capacitor(spl0);
            spl1 = capacitor(spl1);
            spl0 = this.opamp.NE5534.sample(spl0);
            spl1 = this.opamp.NE5534.sample(spl1);
        );
    );
);

