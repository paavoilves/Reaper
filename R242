        //Utility

function second(value)
    (value*srate);

function millisecond(value)
    (value*0.001*srate);
    
function deg(r)
    (r / $pi * 180);
    
function rad(d)
    (d * $pi / 180);
    
function sinh(x)(
(exp(x) - exp(-x)) / 2
);

function cosh(x)(
(exp(x) + exp(-x)) / 2
);

function tanh(x)(
(exp(2*x) - 1) / (exp(2*x) + 1)
);

function clip(value, minvalue, maxvalue)
    (min(max(value, minvalue), maxvalue));

function truncate(value, step)
