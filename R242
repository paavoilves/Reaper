function rgb(r, g, b)
    ( gfx_r = r; gfx_g = g; gfx_b = b; );

function linearize(index, minvalue, maxvalue, curve, filesprites, degrees)(

      floor(
      pow((index - minvalue) / (maxvalue - minvalue),curve)
      *(degrees/(360/filesprites)));

);

function sliderize(value, minvalue, maxvalue, step)(

    truncate(clip(value,minvalue,maxvalue),step);

);

function gfx.knob.interaction(index, x, y, size, defvalue, minvalue, maxvalue, str, curve, step)
instance(active, hover, hover.last, knob.cursor, index, x, y, knob_x, knob_y, width, height, minvalue, maxvalue, curve, step)(

    ui_scale = gfx_w*size;
    midpoint = (size/2)*ui_scale;
    knob_x = gfx_w/2+x*0.01*gfx_w/2-midpoint;
    knob_y = gfx_h/2+y*0.01*gfx_h/2-midpoint;
    gfx.mouse.curve = 1+pow((index - minvalue) / (maxvalue - minvalue),curve);
    
    hover = knob_x < mouse_x && mouse_x < knob_x + size*ui_scale && knob_y < mouse_y && mouse_y < knob_y + size*ui_scale;
    hover && gfx.mouse.left.click ? active = 1;
    gfx.mouse.left.release ? active = 0;
    
    change = 0;
    
    //----drag
    active ? (
        index -= gfx.mouse.y.diff * gfx.mouse.curve * str * (gfx.keyboard.ctrl ? 0.1 : 1);
        index = sliderize(index,minvalue,maxvalue,step);
        change = 1;
    );
    
    //----mousewheel
    hover && gfx.mouse.wheel.scroll ? (
        index += 0.1 * gfx.mouse.wheel * gfx.mouse.curve * str;
        index = sliderize(index,minvalue,maxvalue,step);
        change = 1;
    );
    
    //----doubleclick
    hover && gfx.mouse.left.doubleclick ? (
        index = defvalue;
        change = 1;
    );
    
    //----alt click
    hover && gfx.keyboard.alt && gfx.mouse.left.click? (
        index = defvalue;
        change = 1;
    );
    
    index;

);

