function gfx.button.binary(index, file, x, y, w, h, scale, filesize, minvalue, maxvalue)
instance(index, file, x, y, w, h, button.x, button.y, button.w, button.h, button.l, button.r, button.top, button.bot, midpoint, scale, filesize, minvalue, maxvalue, hover, active, press)(

    ui_scale = gfx_w*scale/filesize;
    midpoint = (filesize/2)*ui_scale;
    button.x = gfx_w/2+x*0.01*gfx_w/2-midpoint;
    button.y = gfx_h/2+y*0.01*gfx_h/2-midpoint;
    button.w = w*ui_scale;
    button.h = h*ui_scale;
    button.l = button.x + midpoint - button.w*0.5;
    button.r = button.l + button.w;
    button.top = button.y + midpoint - button.h*0.5;
    button.bot = button.top + button.h;
    
    hover = button.l < mouse_x && mouse_x < button.r && button.top < mouse_y && mouse_y < button.bot;
    hover && gfx.mouse.left.click ? active = 1;
    gfx.mouse.left.release ? active = 0;
    
    active && gfx.mouse.left && !index ? press = filesize;
    active && gfx.mouse.left && index ? press = -filesize;
    gfx.mouse.left.release ? press = 0;
    
    gfx_blit(file,ui_scale,0,0,(filesize*index*2+press),filesize,filesize,button.x,button.y);

);

