function peaking.init()
instance(rx_n2,rx_n1,rx_n,ru_n2,ru_n1,ru_n,lx_n2,lx_n1,lx_n,lu_n2,lu_n1,lu_n)(

    this.opamp.NE5534.init();
    
    rx_n2 = 0; rx_n1 = 0; rx_n = 0;
    ru_n2 = 0; ru_n1 = 0; ru_n = 0;
    lx_n2 = 0; lx_n1 = 0; lx_n = 0;
    lu_n2 = 0; lu_n1 = 0; lu_n = 0;
);

function peaking.slider(gain,freqk,Q)
instance(gain,gain_linear,freq,Q,w0,q_,a1,a2,phi0,phi1,phi2,G2,aa0,aa1,aa2,bb0,R1,R2,bb2,bb1,W,b0,b1,b2)(

    freq = freqk;
    gain < 0 ? (Q *= 0.15; gain *= 1.25);
    
    gain *= 1.05 * sqrt(sqrt(sqrt(Q)));
    gain_linear = 10^(gain/20);

    w0 = 2 * $pi * freq / srate;
    q_ = 1 / (2 * Q);

    q_ <= 1 ? (
        a1 = -2 * exp(-q_ * w0) * cos(sqrt(1 - sqr(q_)) * w0)
        ):(
        a1 = -2 * exp(-q_ * w0) * cosh(sqrt(sqr(q_) - 1) * w0)
    );
    a2 = exp(-2 * q_ * w0);

    phi0 = 1 - sqr(sin(w0/2));
    phi1 = sqr(sin(w0/2));
    phi2 = 4 * phi0 * phi1;

    aa0 = sqr(1 + a1 + a2);
    aa1 = sqr(1 - a1 + a2);
    aa2 = -4 * a2;

    bb0 = aa0;
    G2 = sqr(gain_linear);
    R1 = (aa0*phi0 + aa1*phi1 + aa2*phi2) * G2;
    R2 = (-aa0 + aa1 + 4*(phi0 - phi1)*aa2) * G2;
    bb2 = (R1 - R2*phi1 - bb0) / (4*sqr(phi1));
    bb1 = R2 + bb0 + 4*(phi1 - phi0)*bb2;


    W = 0.5 * (sqrt(bb0) + sqrt(bb1));
    b0 = 0.5 * (W + sqrt(sqr(W) + bb2));
    b1 = 0.5 * (sqrt(bb0) - sqrt(bb1));
    b2 = -bb2 / (4 * b0);

);

function peaking.sample()
instance(gain,gain_linear,freq,Q,w0,q_,a1,a2,a_1,a_2,phi0,phi1,phi2,G2,aa0,aa1,aa2,bb0,R1,R2,bb2,bb1,W,b0,b1,b2,b_0,b_1,b_2,rx_n2,rx_n1,rx_n,ru_n2,ru_n1,ru_n,lx_n2,lx_n1,lx_n,lu_n2,lu_n1,lu_n)(

    gain_linear != 1 ? (

        //---- added smoothing to prevent filters getting stuck
        smoothing = 0.5;
        a_1 += smoothing * (a1 - a_1);
        a_2 += smoothing * (a2 - a_2);
        b_0 += smoothing * (b0 - b_0);
        b_1 += smoothing * (b1 - b_1);
        b_2 += smoothing * (b2 - b_2);
    
        //---- left
        lx_n2 = lx_n1;
        lx_n1 = lx_n;
        lx_n = spl0;
        
        lu_n2 = lu_n1;
        lu_n1 = lu_n;
        lu_n = b_0*lx_n + b_1*lx_n1 + b_2*lx_n2 - a_1*lu_n1 - a_2*lu_n2;
    
        //---- right
        rx_n2 = rx_n1;
        rx_n1 = rx_n;
        rx_n = spl1;
    
        ru_n2 = ru_n1;
        ru_n1 = ru_n;
        ru_n = b_0*rx_n + b_1*rx_n1 + b_2*rx_n2 - a_1*ru_n1 - a_2*ru_n2;
    
        //----output
        switch1 ? (
            spl0 = lu_n;
            spl1 = ru_n;
            ):(
            spl0 = capacitor(lu_n);
            spl1 = capacitor(ru_n);
            spl0 = this.opamp.NE5534.sample(spl0);
            spl1 = this.opamp.NE5534.sample(spl1);
        );
        
        ):(
        
        //----output
        switch1 ? (
            spl0 = spl0;
            spl1 = spl1;
            ):(
            spl0 = capacitor(spl0);
            spl1 = capacitor(spl1);
            spl0 = this.opamp.NE5534.sample(spl0);
            spl1 = this.opamp.NE5534.sample(spl1);
        );
    );


);

