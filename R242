        //Digital Signal Processing
        
        
function opamp.NE5534.init()
instance(freq,fc,G,G_,fm,phim,alpha,beta,a1,b,b0,b1,alpha_,beta_,a1_,b_,b0_,b1_,
        bias,curve,clip_threshold,slew_limit,prev_input)(

    fc = 20000 / srate * 0.5;
    G  = 10^(6/20);
    G_ = 10^(-6/20);

    fm = 0.9;
    phim = 1 - cos($pi * fm);

    alpha = (2/sqr($pi)) * (1/(sqr(fm) * G * sqr(fc))) - (1/phim);
    beta  = (2/sqr($pi)) * (G/(sqr(fm) * sqr(fc)))     - (1/phim);
    a1 = -alpha / (1 + alpha + sqrt(1 + 2*alpha));
    b  = -beta  / (1 + beta  + sqrt(1 + 2*beta));
    b0 = (1 + a1) / (1 + b);
    b1 = b * b0;

    alpha_ = (2/sqr($pi)) * (1/(sqr(fm) * G_ * sqr(fc))) - (1/phim);
    beta_  = (2/sqr($pi)) * (G_/(sqr(fm) * sqr(fc)))     - (1/phim);
    a1_ = -alpha_ / (1 + alpha_ + sqrt(1 + 2*alpha_));
    b_  = -beta_  / (1 + beta_  + sqrt(1 + 2*beta_));
    b0_ = (1 + a1_) / (1 + b_);
    b1_ = b_ * b0_;

    curve = 40;
    clip_threshold = 10^(2.5/20);
    bias = 0.0005;

    slew_rate = 13;
    slew_limit = slew_rate / (srate / 10^6);

    prev_input = 0;
);

function capacitor(input)
local(input,da.strength,da.retention,da.absorption,da.charge,da.release)(

    da.strength = 0.0001;
    da.retention = 1-da.strength;
    da.absorption = 1-da.retention;

    da.charge = da.charge * da.retention + input * da.absorption;
    da.release = da.charge * da.strength * sign(input);

    input += da.release;
);

function opamp.NE5534.sample(input)
instance(freq,fc,G,G_,fm,phim,alpha,beta,a1,b,b0,b1,alpha_,beta_,a1_,b_,b0_,b1_,
        bias,curve,clip_threshold,slew_limit,prev_input,
        x_n,x_n1,i_n,i_n1,y_n,y_n1,o_n,o_n1,
        drive,absx1,x1,absx2,x2,dc)(

    x_n1 = x_n;
    x_n = input;
    i_n1 = i_n;
    i_n = b0 * x_n + b1 * x_n1 - a1 * i_n1;
    input = i_n;

    input = min(max(input, prev_input - slew_limit), prev_input + slew_limit);
    prev_input = input;

    x1 = (input + bias) / clip_threshold;
    absx1 = abs(x1);
    input = x1 / pow(1 + pow(absx1, curve), 1/curve) * clip_threshold - bias;

    y_n1 = y_n;
    y_n = input;
    o_n1 = o_n;
    o_n = b0_ * y_n + b1_ * y_n1 - a1_ * o_n1;
    input = o_n;

);

function lowpass.init()
instance(lx_n,lx_n1,lu_n,lu_n1,rx_n,rx_n1,ru_n,ru_n1)(

    this.opamp.NE5534.init();

    lx_n = 0; lx_n1 = 0; lu_n = 0; lu_n1 = 0;
    rx_n = 0; rx_n1 = 0; ru_n = 0; ru_n1 = 0;
);

function lowpass.slider(freqk,Q)
instance(freq,Q,w0,q_,a1,a2,phi0,phi1,phi2,aa0,aa1,aa2,bb0,bb1,bb2,R1,b0,b1,b2)(

    freq = freqk * 1000;

    w0 = 2 * $pi * freq / srate;
    q_ = 1 / (2 * Q);

    q_ <= 1 ? (
        a1 = -2 * exp(-q_ * w0) * cos(sqrt(1 - sqr(q_)) * w0)
        ):(
        a1 = -2 * exp(-q_ * w0) * cosh(sqrt(sqr(q_) - 1) * w0)
    );
    a2 = exp(-2 * q_ * w0);

    b2 = 0;

    phi0 = 1 - sqr(sin(w0/2));
    phi1 = sqr(sin(w0/2));
    phi2 = 4 * phi0 * phi1;

    aa0 = sqr(1 + a1 + a2);
    aa1 = sqr(1 - a1 + a2);
    aa2 = -4 * a2;

    bb0 = aa0;
    R1 = (aa0*phi0 + aa1*phi1 + aa2*phi2) * sqr(Q);
    bb1 = (R1 - bb0*phi0) / phi1;

    b0 = 0.5 * (sqrt(bb0) + sqrt(bb1));
    b1 = sqrt(bb0) - b0;

);

function lowpass.sample()
instance(freq,Q,w0,q_,a1,a2,a_1,a_2,phi0,phi1,phi2,aa0,aa1,aa2,bb0,bb1,bb2,R1,b0,b1,b2,b_0,b_1,b_2,rx_n2,rx_n1,rx_n,ru_n2,ru_n1,ru_n,lx_n2,lx_n1,lx_n,lu_n2,lu_n1,lu_n)(

    gain_linear != 1 ? (

        //---- added smoothing to prevent filters getting stuck
        smoothing = 0.5;
        a_1 += smoothing * (a1 - a_1);
        a_2 += smoothing * (a2 - a_2);
        b_0 += smoothing * (b0 - b_0);
        b_1 += smoothing * (b1 - b_1);
        b_2 += smoothing * (b2 - b_2);
    
        //---- left
        lx_n2 = lx_n1;
        lx_n1 = lx_n;
        lx_n = spl0;
        
        lu_n2 = lu_n1;
        lu_n1 = lu_n;
        lu_n = b_0*lx_n + b_1*lx_n1 + b_2*lx_n2 - a_1*lu_n1 - a_2*lu_n2;
        
        //---- right
        rx_n2 = rx_n1;
        rx_n1 = rx_n;
        rx_n = spl1;
        
        ru_n2 = ru_n1;
        ru_n1 = ru_n;
        ru_n = b_0*rx_n + b_1*rx_n1 + b_2*rx_n2 - a_1*ru_n1 - a_2*ru_n2;
    
        //----output
        switch1 ? (
            spl0 = lu_n;
            spl1 = ru_n;
            ):(
            spl0 = capacitor(lu_n);
            spl1 = capacitor(ru_n);
            spl0 = this.opamp.NE5534.sample(spl0);
            spl1 = this.opamp.NE5534.sample(spl1);
        );
        
        //spl0 = ru_n;
        //spl1 = lu_n;

    );
);

